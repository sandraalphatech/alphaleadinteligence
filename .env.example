PORT=3000
NODE_ENV=development
SUPABASE_URL=
SUPABASE_PUBLIC_KEY=
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
EMAIL_API_KEY=

# URL onde a aplicacao corre (usado nos links dos emails de recuperacao)
APP_URL=http://localhost:3000

# Envio direto de emails de prospeccao (OPCIONAL e gratuito). Sem isto, a mensagem abre no teu programa de email ou no Gmail.
# Para o Gmail: ativa a verificacao em 2 passos e cria uma "palavra-passe de aplicacao" (nunca uses a palavra-passe normal).
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_NOME=Nome mostrado a quem recebe
# EMAIL_LIMITE_DIARIO=20

# WhatsApp pela API oficial da Meta (OPCIONAL). Guia completo em docs/whatsapp-setup.md.
# Sem isto, o botao WhatsApp diz que o envio nao esta configurado. Nunca partilhes estes valores.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# ID da conta WhatsApp Business (so serve para o script de verificacao ver se os modelos estao aprovados)
WHATSAPP_WABA_ID=
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_LIMITE_DIARIO=5
